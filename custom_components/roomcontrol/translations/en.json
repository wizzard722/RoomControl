{
  "config": {
    "step": {
      "user": {
        "title": "Add RoomControl",
        "description": "RoomControl creates a light for every area in Home Assistant. Configure each room in the RoomControl panel in the sidebar."
      }
    },
    "abort": {
      "already_configured": "RoomControl is already set up.",
      "single_instance_allowed": "RoomControl is already set up."
    }
  },
  "services": {
    "announce": {
      "name": "Announce",
      "description": "Speak a message on RoomControl's speakers. Rooms where none of the linked persons is home are skipped.",
      "fields": {
        "message": {
          "name": "Message",
          "description": "What is said."
        },
        "areas": {
          "name": "Areas",
          "description": "Only these areas (empty: all)."
        }
      }
    },
    "nspanel_message": {
      "name": "Message on NSPanels",
      "description": "Show a message on the NSPanels (NSPanel Easy) chosen in RoomControl; it disappears again after a while.",
      "fields": {
        "message": {
          "name": "Message",
          "description": "The text shown."
        },
        "label": {
          "name": "Label",
          "description": "The title above it."
        },
        "seconds": {
          "name": "Seconds",
          "description": "How long it stays (0: until the next one; empty: as set in RoomControl)."
        },
        "group": {
          "name": "Group",
          "description": "Name of a panel group set in RoomControl (empty: every panel)."
        }
      }
    }
